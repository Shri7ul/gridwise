# =============================================================================
# GridWise — environment template
# Copy to .env and fill in ONE credential. Never commit the filled-in .env.
# =============================================================================

# --- Provider credential (required: set exactly one of the first three) -------
# Option A — Groq (free tier, fast; this is the default provider)
# Get a key at https://console.groq.com/keys — it looks like gsk_xxxxxxxx...
# NEVER put a real key in this file: .env.example IS committed to the repository
# (only .env itself is git-ignored). Put real values in .env.
GROQ_API_KEY=

# Option B — OpenAI
OPENAI_API_KEY=

# Option C — any OpenAI-compatible endpoint (Together, OpenRouter, vLLM, Ollama)
LLM_API_KEY=

# --- Endpoint and model -------------------------------------------------------
# Groq (default):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Groq retires models periodically. If you get HTTP 404 model_not_found, list
# what your key can actually use:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Other models verified working with this prompt: qwen/qwen3.8-27b, openai/gpt-oss-20b
#
# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# Local Ollama (no key needed; set LLM_API_KEY=ollama):
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.1:8b-instruct

# --- Behaviour tuning ---------------------------------------------------------
# Per-attempt provider timeout, and total budget for the whole request path.
LLM_TIMEOUT_SECONDS=12
REQUEST_DEADLINE_SECONDS=25
# Retries after the first attempt (2 => up to 3 calls).
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1600

# Degraded-availability fallback. Leave false for judging: the challenge requires
# the language model to perform operator-note interpretation. This is a documented
# availability fallback only, and every response it produces says so in the summary.
ALLOW_DETERMINISTIC_FALLBACK=false

# --- Service ------------------------------------------------------------------
PORT=8000
LOG_LEVEL=INFO
APP_VERSION=1.0.0
